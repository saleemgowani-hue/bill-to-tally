# Copy this file to .env and fill in the real values before running.
# NEVER commit the real .env, and NEVER put it inside a customer build.

# The SAME secret used to sign customer licence keys (from the main app's
# .env, LICENSE_SIGNING_SECRET). The proxy uses it only to CHECK a key's
# signature - it never mints keys.
LICENSE_SIGNING_SECRET=

# Your real, paid Gemini API key. Stays on this server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# How many bills one licence key may send through the proxy per day. Caps
# the worst case if a licence key ever leaks.
DAILY_REQUEST_LIMIT=60

GEMINI_TIMEOUT_SECONDS=120

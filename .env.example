# =====================================================================
# AI Bill-to-Tally Stock Update Agent — SN Softech Solutions
# Copy this file to .env and fill in your values. Never commit .env.
# =====================================================================

# ---- branding --------------------------------------------------------
APP_NAME=AI Bill-to-Tally Agent
COMPANY_BRAND=SN Softech Solutions
BRAND_TAGLINE=Smart Software Solutions for Growing Businesses
SUPPORT_CONTACT=9993199719

# ---- security (CHANGE THIS BEFORE DEPLOYING) -------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_TIMEOUT_MINUTES=480
MAX_UPLOAD_MB=15

# ---- database --------------------------------------------------------
# Development (default): SQLite file inside ./data
# DATABASE_URL=sqlite:///./data/billtotally.db
# Production SaaS:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/billtotally
DATA_DIR=./data

# ---- OCR / AI provider ----------------------------------------------
# mock | tesseract | rapidocr | paddle | ppstructure | auto | gemini | openai | claude
# RapidOCR is the default: free, fully offline, no API key, no separate
# program to install, no first-run model download, and noticeably faster
# than Tesseract/PP-StructureV3 with comparable or better accuracy.
# Tesseract is installed too (INSTALL.bat sets up its program automatically)
# as a ready fallback - switch to it any time in Settings -> AI / OCR.
OCR_PROVIDER=rapidocr
OCR_TIMEOUT_SECONDS=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Vendor's own OCR relay (see ocr_proxy/) - lets a customer use a paid AI
# vision engine ("SN Softech Cloud AI" in Settings) without ever holding a
# real Gemini API key on their machine; they enter their own licence key
# instead. Leave blank in your own dev .env - make_customer_build.py fills
# this in automatically for every customer build from YOUR vendor .env.
OCR_PROXY_URL=

# ---- confidence thresholds ------------------------------------------
CONFIDENCE_HIGH=0.90        # green
CONFIDENCE_REVIEW=0.70      # below this = mandatory review

# ---- product matching -----------------------------------------------
MATCH_AUTO_THRESHOLD=0.92   # auto-link at or above this
MATCH_SUGGEST_THRESHOLD=0.60

# ---- validation ------------------------------------------------------
ROUNDING_TOLERANCE=1.0      # rupees

# ---- Tally -----------------------------------------------------------
# KEEP TEST MODE ON until you have verified the voucher format
# against your own Tally company.
TALLY_TEST_MODE=true
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY=
TALLY_TIMEOUT_SECONDS=30

# ---- licensing -------------------------------------------------------
# REQUIRED. Every licence key is signed with this value, and the app will not
# validate any licence until it is filled in. There is deliberately no default:
# a secret baked into the source is no secret at all.
#
# Set it ONCE and keep it safe. Changing it invalidates every key you have
# already issued, and there is no way to recover them.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LICENSE_SIGNING_SECRET=
LICENSE_REQUIRED=true         # false disables the key check (internal use only)
LICENSE_WARN_DAYS=10          # start warning this many days before expiry

# ---- demo accounts ---------------------------------------------------
# A demo company is cleared with the button inside the app, between prospects.
# 0 below means no automatic timer, which is what you want when a person is
# presenting: bills must not vanish while a customer is watching.
# Set minutes above 0 only for an unattended public demo.
DEMO_RETENTION_MINUTES=0
DEMO_SWEEP_INTERVAL_SECONDS=120

# Public showcase deployment only (e.g. Streamlit Cloud): sets up the demo
# company by itself and signs visitors in with one click. Leave false for
# real use.
DEMO_MODE=false
